STORAGE_ROOT=./data
OUTPUT_DIR=./output
ASSETS_DIR=./assets
DEFAULT_TIMEZONE=America/Manaus
CODEX_AUTH_MODE=chatgpt
CODEX_PROVIDER=auto
CODEX_PATH=codex
CODEX_TIMEOUT_SECONDS=300
CODEX_MAX_CONCURRENT_JOBS=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
BLENDER_PATH=
PIPER_PATH=
PIPER_VOICE_PATH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
