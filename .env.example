GOOGLE_DRIVE_FOLDER_ID=
YOUTUBE_CHANNEL_ID=
TIKTOK_DIRECT_POST_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
RENDER_MAX_CONCURRENT=1
RENDER_DEFAULT_WIDTH=720
RENDER_DEFAULT_HEIGHT=1280
RENDER_DEFAULT_FPS=24
AUTO_PUBLISH=false
REQUIRE_HUMAN_APPROVAL=true
MAX_UPLOAD_MB=100
