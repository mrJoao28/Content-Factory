APP_ENV=development
APP_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=sqlite:///./data/content_factory.db
STORAGE_ROOT=./data
OUTPUT_DIR=./output
ASSETS_DIR=./assets
DEFAULT_TIMEZONE=America/Manaus
AI_PROVIDER=chatgpt
CHATGPT_LOGIN_TIMEOUT_SECONDS=300

CODEX_AUTH_MODE=chatgpt
CODEX_PROVIDER=auto
CODEX_PATH=codex
CODEX_TIMEOUT_SECONDS=300
CODEX_MAX_CONCURRENT_JOBS=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
BLENDER_PATH=
# Local 3D: Blender 4.5 or 5.2 LTS, CPU only; no automatic engine fallback.
BLENDER_THREADS=2
BLENDER_TIMEOUT_SECONDS=7200
BLENDER_DISK_BUDGET_MB=4096
PIPER_PATH=
PIPER_VOICE_PATH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
GOOGLE_DRIVE_FOLDER_ID=
YOUTUBE_CHANNEL_ID=
TIKTOK_DIRECT_POST_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
RENDER_MAX_CONCURRENT=1
RENDER_DEFAULT_WIDTH=720
RENDER_DEFAULT_HEIGHT=1280
RENDER_DEFAULT_FPS=24
AUTO_PUBLISH=false
REQUIRE_HUMAN_APPROVAL=true
MAX_UPLOAD_MB=100

# Direct ChatGPT inference budgets (bytes). Total traffic includes all attempts per role.
CHATGPT_STREAM_MAX_BYTES=16777216
CHATGPT_EVENT_MAX_BYTES=2097152
CHATGPT_TEXT_MAX_BYTES=1048576
# If omitted, existing CODEX_TIMEOUT_SECONDS remains the compatibility default.
CHATGPT_TIMEOUT_SECONDS=300
